0888524136,"size":"M","radius":1024,"colorName":"pink","color":{"hi":"#fff0fa","core":"#ff80e0","glow":"#ee2090","edge":"#880044"},"name":"Aether Mizar","planetIds":[845,846,847,848,849,850],"proxyPlanetId":50233,"_orbitMaxR":8956.649692446725,"_maxPlanetOrbit":8756.649692446725}},{"type":"planet_first_visit","sd":833.4941589007346,"pln":"Aether Mizar","plnId":50233},{"type":"star_discovered","sd":833.5682066961433,"starName":"Sabik","_str":{"id":130,"x":34922.413774711196,"y":-5330.133985527453,"size":"L","radius":2048,"colorName":"teal","color":{"hi":"#defffa","core":"#40ffdd","glow":"#00bb88","edge":"#005544"},"name":"Sabik","planetIds":[469,470,471],"proxyPlanetId":50130,"_orbitMaxR":8207.12612523865,"_maxPlanetOrbit":8007.126125238651}},{"type":"planet_first_visit","sd":833.5682066961433,"pln":"Sabik","plnId":50130},{"type":"fleet_expanded","sd":833.6195212332036,"pln":"Orijen","plnId":88},{"type":"planet_first_visit","sd":833.625920403366,"pln":"Valkronan","plnId":90},{"type":"star_discovered","sd":833.6426421589882,"starName":"Aquarius Alpha","_str":{"id":297,"x":28975.882326196297,"y":8175.453461383731,"size":"S","radius":512,"colorName":"white","color":{"hi":"#ffffff","core":"#f4f4ff","glow":"#d0d0f0","edge":"#9090b0"},"name":"Aquarius Alpha","planetIds":[1083,1084],"proxyPlanetId":50297,"_orbitMaxR":3917.3753663552816,"_maxPlanetOrbit":3717.3753663552816}},{"type":"planet_first_visit","sd":833.6426421589882,"pln":"Aquarius Alpha","plnId":50297},{"type":"ai_cargo_delivered","sd":833.7058215230619,"pln":"Rakkalel","plnId":770,"crgName":"Molten Ore"},{"type":"station_built","sd":833.7136616550316,"pln":"Valkronan","plnId":90},{"type":"star_discovered","sd":833.7242345404468,"starName":"Triangulum","_str":{"id":117,"x":21235.286859473475,"y":21663.787089058897,"size":"M","radius":1024,"colorName":"yellow","color":{"hi":"#fffce0","core":"#ffe040","glow":"#ffaa10","edge":"#cc6010"},"name":"Triangulum","planetIds":[422,423,424,425],"proxyPlanetId":50117,"_orbitMaxR":8726.803302269485,"_maxPlanetOrbit":8526.803302269485}},{"type":"planet_first_visit","sd":833.7242345404468,"pln":"Triangulum","plnId":50117}],"_newsSnapshot":{"credits":131788,"stationCount":19,"aiTrainCount":7,"aiStationCount":6},"_newspaperArchive":[{"sd":830,"layout":0,"issueNum":1,"paperName":"The Interstellar Courier","paperSlogan":"Swift as starlight, sharp as a comet","major":{"headline":"Drexler's Quasar Bound Founded at Orijen — Jaemin Named as First CEO","body1":"In a formal ceremony at Orijen, Drexler's Quasar Bound officially registered as a galactic freight corporation. CEO Jaemin, who helms the operation, christened the company's inaugural train — the IRON EXPRESS — as it departed Orijen Station on its first commercial run.","body2":"\"Every planet that has goods to move deserves a reliable partner,\" Jaemin stated at the founding reception. The corporation enters a competitive market, but analysts note that first-mover advantages at Orijen could prove decisive in the stardates ahead.","pageNum":1,"imgType":"ceo_jaemin","_pln":{"id":88},"_str":null},"minor1":{"headline":"Route Discovery: Shortcut Found Through Gigi Prime Cluster","line1":"The Gigi Prime outer system yielded a surprise discovery this starcycle when a scout probe relayed imagery of a previously unknown asteroid cluster.","line2":"Navigation charts have been updated to include the new hazard zone.","pageNum":6},"minor2":{"headline":"Fog Retreats: New Corridor Opens to Outer Sectors","line1":"Fog coverage near Ulphonix has thinned enough to allow preliminary survey scans, revealing terrain consistent with habitable conditions.","line2":"Trade authorities have placed the planet on a watch list for potential route development.","pageNum":6}},{"sd":831,"layout":1,"issueNum":2,"paperName":"The Interstellar Courier","paperSlogan":"Swift as starlight, sharp as a comet","major":{"headline":"Stellar Transport Corp. Established at Cadrelar — Gigi Takes the Helm","body1":"Stellar Transport Corp. has formally entered the galactic freight business, establishing its base of operations at Cadrelar. Gigi, the corporation's newly appointed director, confirmed the launch of its first train, the Stellar No.1, which departed Cadrelar this starcycle.","body2":"\"We are here to compete,\" Gigi said in a brief public statement. The arrival of Stellar Transport Corp. draws immediate comparisons to Drexler's Quasar Bound, which also launched recently. Whether there is room in the galaxy for both corporations remains an open question.","pageNum":1,"imgType":"ceo_gigi","_pln":{"id":769},"_str":null},"minor1":{"headline":"Cargo Capacity Record: Drexler's Quasar Bound Moves Most in Single Load","line1":"Freight volume data released this starcycle shows Drexler's Quasar Bound leading all known operators in total cargo moved per unit of time.","line2":"The statistic reinforces Drexler's Quasar Bound's reputation as the most efficient carrier in the sector.","pageNum":14},"minor2":{"headline":"Revenue Milestone: Drexler's Quasar Bound Net Worth Crosses Major Threshold","line1":"Drexler's Quasar Bound crossed a significant financial threshold this starcycle, logging its highest net revenue figure since founding.","line2":"Analysts see the milestone as confirmation that the corporation's strategy is delivering results.","pageNum":12}},{"sd":832,"layout":2,"issueNum":3,"paperName":"The Interstellar Courier","paperSlogan":"Swift as starlight, sharp as a comet","major":{"headline":"Drexler's Quasar Bound Declares Victory in the Orijen Trade Corridor","body1":"Drexler's Quasar Bound's latest figures have stunned observers with numbers that surpass even the most optimistic projections. The corporation, now a household name across dozens of star systems, continues to grow at a pace previously thought impossible.","body2":"The CEO of Drexler's Quasar Bound addressed employees in a system-wide broadcast, stating that success comes from a relentless commitment to every planet they serve. Bonuses have been distributed across all divisions.","pageNum":3,"imgType":"planet","_pln":{"id":88},"_str":{"id":25},"image":{"kind":"real_planet","planetId":88}},"minor1":{"headline":"Record: Most Hazardous Materials Delivered in a Single Stardate","line1":"Freight volume data released this starcycle shows Drexler's Quasar Bound leading all known operators in total cargo moved per unit of time.","line2":"The statistic reinforces Drexler's Quasar Bound's reputation as the most efficient carrier in the sector.","pageNum":13},"minor2":{"headline":"Corporate Bonus Paid Out: Drexler's Quasar Bound Staff Rewarded for Quarter","line1":"Freight volume data released this starcycle shows Drexler's Quasar Bound leading all known operators in total cargo moved per unit of time.","line2":"The statistic reinforces Drexler's Quasar Bound's reputation as the most efficient carrier in the sector.","pageNum":11}},{"sd":833,"layout":0,"issueNum":4,"paperName":"The Interstellar Courier","paperSlogan":"Swift as starlight, sharp as a comet","major":{"headline":"Gigi of Stellar Transport Corp. Announces Corridor: Rakkalel to Vorthosia","body1":"Stellar Transport Corp. launched a new freight route to Vorthosia this starcycle, with Gigi confirming that regular cargo runs have already begun.","body2":"\"This route is a statement of intent,\" Gigi said. Stellar Transport Corp.'s expansion into the Vorthosia corridor puts it in direct competition with Erics slutty hoes, which has operated in the region for several stardates.","pageNum":7,"imgType":"train","_pln":{"id":768},"_str":{"id":25},"image":{"kind":"real_engine","spriteKey":"engine_constellation"}},"minor1":{"headline":"Stellar Transport Corp. Delivers Livestock to Vorthosia — Gigi Calls Run a Success","line1":"Stellar Transport Corp. completed a Livestock delivery to Vorthosia this starcycle, with Gigi citing the run as evidence of the corporation's growing reach.","line2":"The delivery follows recent reports of increased Stellar Transport Corp. activity in the region, drawing attention from competitors.","pageNum":12},"minor2":{"headline":"Stellar Transport Corp. Engine Overheats Near Gigi Prime: Crew Safe, Route Delayed","line1":"A Stellar Transport Corp. freight train was reported grounded near Vorthosia this starcycle after a routine inspection uncovered mechanical faults.","line2":"Repairs are underway and the train is expected to return to service within the starcycle.","pageNum":13}}]}