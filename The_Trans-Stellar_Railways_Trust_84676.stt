issueNum":1,"paperName":"The Stellar Tribune","paperSlogan":"From the core to the rim — we cover it all","major":{"headline":"The Trans-Stellar Railways Trust Founded at Orijen — Jaemin Named as First CEO","body1":"In a formal ceremony at Orijen, The Trans-Stellar Railways Trust officially registered as a galactic freight corporation. CEO Jaemin, who helms the operation, christened the company's inaugural train — the IRON EXPRESS — as it departed Orijen Station on its first commercial run.","body2":"\"Every planet that has goods to move deserves a reliable partner,\" Jaemin stated at the founding reception. The corporation enters a competitive market, but analysts note that first-mover advantages at Orijen could prove decisive in the stardates ahead.","pageNum":1,"imgType":"ceo_jaemin","_pln":{"id":1017,"starId":275,"orbitRadius":3921.5041570774456,"orbitAngle":18.865953224171413,"orbitSpeed":0.00011291682608339635,"x":8686.61312641333,"y":-12606.871649035678,"size":"L","radius":192,"type":{"id":"resort","base":"#0e58b8","hi":"#38aaf0","rim":[65,175,255],"_b":{"id":"resort","lms":[{"cx":-0.609886639514159,"cy":-0.5373405497090872,"rx":0.7115559337753803,"ry":0.3061348754307255,"rot":2.515382996232589,"isLarge":true,"pts":[{"x":-0.4042056774396139,"y":0.1257881925953698},{"x":-0.8858909853844757,"y":0.06833670628480824},{"x":-0.8247175183635523,"y":-0.09873003418636568},{"x":-0.38299190851212733,"y":-0.14457412417004065},{"x":-0.27694262429497407,"y":-0.2803997285653194},{"x":0.02688540683201115,"y":-0.2459838057021515},{"x":0.2850095066419095,"y":-0.2267199901101622},{"x":0.6482589831904273,"y":-0.2017372104859123},{"x":0.6413775791603352,"y":-0.049475197250956685},{"x":0.9228590645855165,"y":0.11047892759270869},{"x":0.6534923585349052,"y":0.24668428571776568},{"x":0.3116444464768619,"y":0.31553473728885695},{"x":-0.027609261491131774,"y":0.25260660017717274},{"x":-0.4536728022500606,"y":0.3608886400011005}],"sand":"rgba(220,210,127,0.93)","veg":"rgba(58,155,49,0.9